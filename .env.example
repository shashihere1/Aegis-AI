# The app loads repository-root .env, then .env.local; process environment variables override both.
# Never commit real values. For Azure-only setup, use .env.azure.example and docs/azure-openai.md.
# This full reference includes database overrides; do not copy it unchanged over a PostgreSQL setup.
AEGIS_CONTROL_URL=http://127.0.0.1:8000
AEGIS_GATEWAY_URL=http://127.0.0.1:8000/gw
AEGIS_DATABASE_URL=sqlite+aiosqlite:///./aegis.db
# Persistent signing keys. Empty -> ephemeral keys (fine for tests and laptop demos, where the
# signing identity may change on restart). For the PostgreSQL console, point these at protected
# files and create them ONCE before first start:  python -m aegis.keys init
# After that, startup only loads them and fails closed if a configured key is missing or malformed.
AEGIS_SIGNING_KEY_PATH=
# AEGIS_SIGNING_KEY_PATH=.local/keys/sts.pem
# AEGIS_IDP_KEY_PATH=.local/keys/idp.pem
# AEGIS_IDENTITY_STATE_DIR=.local/identities
# python (default, the Python mirror) | rego (the Rego in-process, needs regopy) | opa (an OPA server at AEGIS_OPA_URL)
AEGIS_POLICY_ENGINE=python
AEGIS_OPA_URL=http://localhost:8181
# AEGIS_OPA_TIMEOUT_SECONDS=2
# AEGIS_OPA_TOKEN=<bearer token for an authenticating proxy in front of OPA>
# AEGIS_OPA_PUSH_POLICY=true    # Aegis pushes the approved Rego to OPA; false: OPA is deployed elsewhere, Aegis only verifies
AEGIS_HOTSTORE_URL=
# Gateway → control-plane identity (asymmetric, no shared secret). Empty = ephemeral key pair, generated
# in-process for local single-process runs. For split deployments give the Gateway its private key and the
# control plane the matching public key (Key Vault references in Azure).
AEGIS_GATEWAY_SERVICE_KEY_PATH=
AEGIS_GATEWAY_SERVICE_PUBLIC_KEY_PATH=
# Browser CORS: exact origins only, comma-separated, no wildcards. Set to the console's deployed URL.
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Direct TLS termination (leave empty when a proxy / Azure Container Apps ingress terminates TLS).
AEGIS_TLS_CERT_FILE=
AEGIS_TLS_KEY_FILE=

# OneStop-approved Azure OpenAI deployment (never put real keys in this tracked example)
AEGIS_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AEGIS_AZURE_OPENAI_API_KEY=<from-key-vault>
AEGIS_AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AEGIS_AZURE_OPENAI_API_VERSION=2024-10-21
# Python model controls; unknown footprint fails closed. Do not infer it from resource location.
AEGIS_LLM_PROCESSING_SCOPE=unknown
AEGIS_LLM_ALLOWED_PROCESSING_SCOPE=eu
AEGIS_LLM_MAX_DATA_CLASS=confidential
AEGIS_LLM_DAILY_BUDGET_EUR=1.00

# Optional: OpenTelemetry export
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# Sign-in for people (any OpenID Connect provider). Leave AEGIS_OIDC_ISSUER empty for no SSO.
# AEGIS_OIDC_ISSUER=https://<keycloak-host>/realms/<realm>     # Entra: https://login.microsoftonline.com/<tenant-id>/v2.0
# AEGIS_OIDC_CLIENT_ID=<console-public-client-id>
# AEGIS_OIDC_AUDIENCE=                                         # defaults to the client id
# AEGIS_OIDC_ROLES_CLAIM=realm_access.roles                    # Entra: roles
# AEGIS_OIDC_ONE_ROLE_PER_ACCOUNT=true                         # refuse logins that hold more than one Aegis role
# AEGIS_OIDC_ROLE_MAP={"aegis-approver":"risk-approver","aegis-soc":"soc-analyst"}
# Turn the passwordless persona switcher off outside demos:
AEGIS_ENABLE_DEV_LOGIN=true
# Ownership re-attestation: owners re-confirm each active agent on this schedule (0 days = campaigns stay manual).
# AEGIS_ATTESTATION_INTERVAL_DAYS=90
# AEGIS_ATTESTATION_GRACE_DAYS=14                              # time an owner (or a new owner) has to confirm
# AEGIS_ATTESTATION_AUTO_ENFORCE=false                         # true: suspend overdue agents instead of only alerting
# Demo-only built-in provider (serve --sso sets these for one run; never enable on a shared host):
# AEGIS_BUILTIN_OIDC=false
# AEGIS_BUILTIN_OIDC_PASSWORD=<one-shared-demo-password>

# Where agents get their own identity: dev (built-in demo IdP) or keycloak (one Keycloak client per agent).
AEGIS_AGENT_IDP=dev
# AEGIS_KEYCLOAK_URL=http://127.0.0.1:8080
# AEGIS_KEYCLOAK_REALM=aegis
# AEGIS_KEYCLOAK_ADMIN_CLIENT_ID=aegis-control-plane       # service account with manage-clients / view-clients only
# AEGIS_KEYCLOAK_ADMIN_CLIENT_SECRET=<from-key-vault>
# AEGIS_AGENT_TOKEN_TTL=300
