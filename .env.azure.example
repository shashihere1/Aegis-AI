# Azure-only example: place these settings in repository-root .env or .env.local.
# Both local files are Git-ignored. Never put a real key in this tracked example.
# A blank key is intentionally not ready. Enter your approved resource's Key 1 or Key 2 locally.
# Existing process environment variables take precedence over this file.
AEGIS_AZURE_OPENAI_ENDPOINT=https://aegis-test-1435115.openai.azure.com
AEGIS_AZURE_OPENAI_DEPLOYMENT=aegis-chat
AEGIS_AZURE_OPENAI_API_VERSION=2025-01-01-preview
AEGIS_AZURE_OPENAI_API_KEY=
# Global Standard can process globally. Enable these only with approval for synthetic demo inference.
# Unconfigured/unknown processing geography fails closed, including smoke calls.
# AEGIS_LLM_PROCESSING_SCOPE=global
# AEGIS_LLM_ALLOWED_PROCESSING_SCOPE=global
AEGIS_LLM_DAILY_BUDGET_EUR=1.00
AEGIS_LLM_MAX_DATA_CLASS=confidential
